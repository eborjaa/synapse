# Synapse — local-first and private. Keep sensitive/derived artifacts out of git.

# The records database is derived (replayable from migrations/), sensitive, and binary.
db/*.db
db/*.db-wal
db/*.db-shm
db/*.sqlite
db/*.sqlite3

# Episodic memory is per-machine PRIMARY data (db/episodes.db) — matched by db/*.db above.
# Unlike the embeddings cache it is NOT rebuildable: back it up if the history matters to you.

# Embeddings-freshness runtime artifacts (all per-machine, all rebuildable)
db/.embed.lock/
db/.embed-check.json
db/embed-rebuild.log

# Tooling
node_modules/
dist/

# Transient agent-runtime session logs (the curated audit trail lives in inbox/curator/logs/)
_meta/logs/

# macOS / editor noise
.DS_Store
*.swp

# Obsidian: keep vault config; ignore volatile per-machine workspace + cache
.obsidian/workspace*.json
.obsidian/cache

# Editor workspace files (per-machine)
*.code-workspace
