# Idle VPN sidecar. Replace by setting VPN_IMAGE=tailscale/tailscale (or wireguard, etc).
# Sleeps so the stack comes up on a laptop with no tunnel; swapping the VPN is swapping this image.

FROM busybox:1.36

CMD ["sh", "-c", "echo synapse vpn-sidecar idle — set VPN_IMAGE to terminate a real tunnel; sleep infinity"]
